[Unit]
Description=StarFree replacement API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/starfree-replacement
Environment=APP_PORT=18082
Environment=DB_HOST=127.0.0.1
Environment=DB_PORT=3306
Environment=DB_NAME=lcxqy
Environment=LEGACY_API_BASE_URL=http://127.0.0.1:8081
ExecStart=/opt/starfree-replacement/start.sh
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
